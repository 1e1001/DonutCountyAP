<Project Sdk="Microsoft.NET.Sdk">
	
    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <AssemblyName>DonutCountyAP</AssemblyName>
        <Description>Archipelago implementation for Donut County (2018)</Description>
        <Version>0.1.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <!-- you may need this for getting the multiclient dll to output for .net 6 and netstandard 2.0 -->
        <!--        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RootNamespace>DonutCountyAP</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <!--<OutputPath>lib\Donut County\BepInEx\plugins\$(AssemblyName)</OutputPath>-->
		<OutputPath>bin\Debug\$(AssemblyName)</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\$(AssemblyName)</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>

	<Target Name="SelectiveCopy" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<!-- TODO: this looks awful but idk anything about vs projects -->
		<Copy SourceFiles="bin\Debug\$(AssemblyName)\$(AssemblyName).dll" DestinationFolder="lib\Donut County\BepInEx\plugins\$(AssemblyName)\" />
		<Copy SourceFiles="bin\Debug\$(AssemblyName)\Archipelago.MultiClient.Net.dll" DestinationFolder="lib\Donut County\BepInEx\plugins\$(AssemblyName)\" />
		<Copy SourceFiles="bin\Debug\$(AssemblyName)\Newtonsoft.Json.dll" DestinationFolder="lib\Donut County\BepInEx\plugins\$(AssemblyName)\" />
		<Copy SourceFiles="lib\wspp\websocket-sharp.dll" DestinationFolder="lib\Donut County\BepInEx\plugins\$(AssemblyName)\" />
		<Copy SourceFiles="lib\wspp\c-wspp.dll" DestinationFolder="lib\Donut County\BepInEx\plugins\$(AssemblyName)\" />
	</Target>
	<Target Name="SelectiveCopyRelease" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<Copy SourceFiles="bin\Release\$(AssemblyName)\$(AssemblyName).dll" DestinationFolder="bin\Release\$(AssemblyName)-select\" />
		<Copy SourceFiles="bin\Release\$(AssemblyName)\Archipelago.MultiClient.Net.dll" DestinationFolder="bin\Release\$(AssemblyName)-select\" />
		<Copy SourceFiles="bin\Release\$(AssemblyName)\Newtonsoft.Json.dll" DestinationFolder="bin\Release\$(AssemblyName)-select\" />
		<Copy SourceFiles="lib\wspp\websocket-sharp.dll" DestinationFolder="bin\Release\$(AssemblyName)-select\" />
		<Copy SourceFiles="lib\wspp\c-wspp.dll" DestinationFolder="bin\Release\$(AssemblyName)-select\" />
	</Target>
    <Target Name="ZipMod" AfterTargets="SelectiveCopyRelease" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <ZipDirectory SourceDirectory="bin\Release\$(AssemblyName)-select\" DestinationFile="bin\Release\$(AssemblyName)-$(Version).zip" Overwrite="true" />
    </Target>

    <ItemGroup>
      <Compile Remove="lib\export\**" />
      <EmbeddedResource Remove="lib\export\**" />
      <None Remove="lib\export\**" />
    </ItemGroup>

    <ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.6.0" />
		<PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="1.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="UnityEngine.Modules" Version="2017.4.4" IncludeAssets="compile" />
		<Reference Include="Assembly-CSharp">
			<HintPath>lib\Donut County\DonutCounty_Data\Managed\Assembly-CSharp.dll</HintPath>
		</Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

</Project>
